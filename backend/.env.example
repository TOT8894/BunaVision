# Copy to .env (never commit .env). Required values have no defaults on purpose.

# --- required ---
VISION_SERVICE_URL=http://localhost:9000
GEMINI_API_KEY=
# Model ids are retired over time (gemini-2.5-flash has a published shutdown date).
# Pick a current one from https://ai.google.dev/gemini-api/docs/deprecations
GEMINI_MODEL=
# memory = dev/test only (images and records vanish on restart); s3 for real use
IMAGE_STORE=memory
# memory is the only implemented store until the database decision is made
ASSESSMENT_STORE=memory

# --- required only when IMAGE_STORE=s3 (credentials come from the AWS role / default chain) ---
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT_URL=http://localhost:9001   # S3-compatible store for local development

# --- optional (defaults shown) ---
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# MAX_IMAGE_BYTES=10485760
# MAX_IMAGE_PIXELS=40000000
# MIN_IMAGE_SIDE_PX=320
# RETAIN_ORIGINAL_IMAGE=true
# IMAGE_URL_TTL_S=900
# VISION_TIMEOUT_S=30
# VISION_CONNECT_TIMEOUT_S=3
# GEMINI_TIMEOUT_S=30
# GEMINI_TEMPERATURE=0.2
# GEMINI_MAX_OUTPUT_TOKENS=8192
# LOG_LEVEL=INFO
