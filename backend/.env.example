# Copy to .env (never commit .env). Variables without a default must be set or the app will
# not start.

# --- Required -----------------------------------------------------------------------------
VISION_SERVICE_URL=http://localhost:9000
GEMINI_API_KEY=
# Pick a current model from Google's Gemini deprecations page; models are retired over time.
GEMINI_MODEL=
DATABASE_URL=postgresql+asyncpg://bunavision:change-me@localhost:5432/bunavision
# At least 32 characters. Generate: openssl rand -hex 32
JWT_SECRET=
# memory = development only (images lost on restart, URLs not fetchable); s3 = real storage
IMAGE_STORE=memory

# --- Required when IMAGE_STORE=s3 -----------------------------------------------------------
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT_URL=http://localhost:9001   # only for MinIO or another S3-compatible store

# --- Optional (defaults shown) --------------------------------------------------------------
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://app.example.com
# MAX_IMAGE_BYTES=10485760
# MAX_IMAGE_PIXELS=50000000
# MIN_IMAGE_SIDE_PX=320
# RETAIN_ORIGINAL_IMAGE=true
# IMAGE_URL_TTL_S=900
# ACCESS_TOKEN_TTL_S=3600
# MAX_ASSESSMENTS_PER_USER_PER_HOUR=30
# MAX_CONCURRENT_ASSESSMENTS=4
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# VISION_TIMEOUT_S=30
# VISION_CONNECT_TIMEOUT_S=3
# VISION_RELOAD_TIMEOUT_S=60
# GEMINI_TIMEOUT_S=30
# GEMINI_TEMPERATURE=0.2
# GEMINI_MAX_OUTPUT_TOKENS=8192
# LOG_LEVEL=INFO
