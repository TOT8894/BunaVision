# Export these in your shell or pass them to the container (Django does not read .env itself):
#   set -a; source .env; set +a
# Variables without a default must be set or the app will not start.

# --- Required -----------------------------------------------------------------------------
SECRET_KEY=            # openssl rand -hex 32 ; signs tokens and sessions
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://bunavision:change-me@localhost:5432/bunavision
VISION_SERVICE_URL=http://localhost:9000
GEMINI_API_KEY=
GEMINI_MODEL=          # pick a current model from Google's deprecations page
IMAGE_STORE=memory     # memory = development only; s3 = real storage

# --- Required when IMAGE_STORE=s3 -----------------------------------------------------------
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT_URL=http://localhost:9001   # MinIO or another S3-compatible store only

# --- Optional (defaults shown) --------------------------------------------------------------
# DEBUG=false
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# REDIS_URL=redis://localhost:6379/0     # shared throttle counters; default is a DB cache table
# NUM_PROXIES=0                          # number of reverse proxies in front (for client IPs)
# WEB_CONCURRENCY=2
# GUNICORN_THREADS=4
# MAX_IMAGE_BYTES=10485760
# MAX_IMAGE_PIXELS=50000000
# MIN_IMAGE_SIDE_PX=320
# RETAIN_ORIGINAL_IMAGE=true
# IMAGE_URL_TTL_S=900
# ACCESS_TOKEN_TTL_S=3600
# MAX_ASSESSMENTS_PER_USER_PER_HOUR=30
# VISION_TIMEOUT_S=30
# VISION_CONNECT_TIMEOUT_S=3
# VISION_RELOAD_TIMEOUT_S=60
# GEMINI_TIMEOUT_S=30
# GEMINI_TEMPERATURE=0.2
# GEMINI_MAX_OUTPUT_TOKENS=8192
# LOG_LEVEL=INFO
