{
  "openapi": "3.1.0",
  "info": {
    "title": "BunaVision - Defect Detection Service",
    "description": "Standalone YOLOv8 ONNX defect detection for green coffee beans.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/detect": {
      "post": {
        "tags": [
          "Inference"
        ],
        "summary": "Detect Defects",
        "operationId": "detect_defects_detect_post",
        "parameters": [
          {
            "name": "confidence",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 0.95,
              "minimum": 0.05,
              "description": "Confidence threshold",
              "default": 0.25,
              "title": "Confidence"
            },
            "description": "Confidence threshold"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_detect_defects_detect_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/YOLODetectionResult"
                }
              }
            }
          },
          "400": {
            "description": "Image does not appear to contain green coffee beans",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DomainRejectionResponse"
                }
              }
            }
          },
          "500": {
            "description": "Inference processing failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Inference model unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/reload-model": {
      "post": {
        "tags": [
          "Admin"
        ],
        "summary": "Reload Model",
        "operationId": "reload_model_reload_model_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReloadModelResponse"
                }
              }
            }
          },
          "500": {
            "description": "Model reload failed; active model bundle retained",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_detect_defects_detect_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "Green coffee bean sample photo"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_detect_defects_detect_post"
      },
      "BoundingBox": {
        "properties": {
          "x1": {
            "type": "number",
            "title": "X1",
            "description": "Top-left X coordinate (pixels)"
          },
          "y1": {
            "type": "number",
            "title": "Y1",
            "description": "Top-left Y coordinate (pixels)"
          },
          "x2": {
            "type": "number",
            "title": "X2",
            "description": "Bottom-right X coordinate (pixels)"
          },
          "y2": {
            "type": "number",
            "title": "Y2",
            "description": "Bottom-right Y coordinate (pixels)"
          }
        },
        "type": "object",
        "required": [
          "x1",
          "y1",
          "x2",
          "y2"
        ],
        "title": "BoundingBox"
      },
      "DetectedBean": {
        "properties": {
          "box": {
            "$ref": "#/components/schemas/BoundingBox",
            "description": "Bounding box coordinates"
          },
          "class_name": {
            "type": "string",
            "title": "Class Name",
            "description": "Canonical English defect class name"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "description": "Detection confidence score (0-1)"
          },
          "category": {
            "type": "string",
            "title": "Category",
            "description": "'Primary Defect', 'Secondary Defect', or 'Healthy'"
          }
        },
        "type": "object",
        "required": [
          "box",
          "class_name",
          "confidence",
          "category"
        ],
        "title": "DetectedBean"
      },
      "DomainRejectionDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "description": "Error code for domain rejection",
            "default": "IMAGE_NOT_COFFEE"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Explanation of rejection"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence",
            "description": "Validator confidence score that image is coffee"
          },
          "threshold": {
            "type": "number",
            "title": "Threshold",
            "description": "Required threshold for coffee classification"
          }
        },
        "type": "object",
        "required": [
          "message",
          "confidence",
          "threshold"
        ],
        "title": "DomainRejectionDetail"
      },
      "DomainRejectionResponse": {
        "properties": {
          "detail": {
            "$ref": "#/components/schemas/DomainRejectionDetail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "DomainRejectionResponse"
      },
      "HTTPErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail",
            "description": "Error message"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "HTTPErrorResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "'healthy' or 'unavailable'"
          },
          "service": {
            "type": "string",
            "title": "Service",
            "description": "Service identifier"
          },
          "engine": {
            "type": "string",
            "title": "Engine",
            "description": "Inference engine type: 'onnx' or 'none'"
          },
          "model_loaded": {
            "type": "boolean",
            "title": "Model Loaded",
            "description": "Whether model weights are loaded"
          },
          "model_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Path",
            "description": "Path to loaded model weights"
          },
          "supported_classes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Supported Classes",
            "description": "Defect classes this model detects"
          }
        },
        "type": "object",
        "required": [
          "status",
          "service",
          "engine",
          "model_loaded"
        ],
        "title": "HealthResponse"
      },
      "ReloadModelResponse": {
        "properties": {
          "reloaded": {
            "type": "boolean",
            "title": "Reloaded"
          },
          "engine": {
            "type": "string",
            "title": "Engine"
          },
          "model_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Path"
          }
        },
        "type": "object",
        "required": [
          "reloaded",
          "engine"
        ],
        "title": "ReloadModelResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "YOLODetectionResult": {
        "properties": {
          "model_version": {
            "type": "string",
            "title": "Model Version",
            "description": "Model identifier, e.g. 'YOLOv8n-Coffee-ONNX-v1'"
          },
          "validator_version": {
            "type": "string",
            "title": "Validator Version",
            "description": "Coffee-domain model identifier, e.g. 'MobileNetV3-Small-Coffee-ONNX-v1'"
          },
          "is_coffee": {
            "type": "boolean",
            "title": "Is Coffee",
            "description": "Whether the image contains green coffee beans based on domain validator",
            "default": true
          },
          "coffee_confidence": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Coffee Confidence",
            "description": "Confidence score from the domain validator"
          },
          "total_beans": {
            "type": "integer",
            "minimum": -1.0,
            "title": "Total Beans",
            "description": "Total sample bean count; -1 means YOLO does not estimate this count"
          },
          "healthy_beans": {
            "type": "integer",
            "minimum": -1.0,
            "title": "Healthy Beans",
            "description": "Healthy bean count. -1 means 'not determinable by YOLO' \u2014 this model was trained only on defect classes and cannot count healthy beans. The backend estimates the real value from the full image."
          },
          "defect_beans": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Defect Beans",
            "description": "Count of defective bean instances"
          },
          "defect_counts": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Defect Counts",
            "description": "Raw count per defect class e.g. {'Full Black': 2}"
          },
          "detected_beans": {
            "items": {
              "$ref": "#/components/schemas/DetectedBean"
            },
            "type": "array",
            "title": "Detected Beans",
            "description": "Full list of bounding box detections"
          },
          "annotated_image_base64": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Annotated Image Base64",
            "description": "Base64-encoded JPEG with colored bounding boxes drawn"
          }
        },
        "type": "object",
        "required": [
          "model_version",
          "validator_version",
          "total_beans",
          "healthy_beans",
          "defect_beans"
        ],
        "title": "YOLODetectionResult"
      }
    }
  }
}
